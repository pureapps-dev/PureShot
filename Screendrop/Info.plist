<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Image</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.image</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>PureShot records your camera alongside the screen so you can add a camera bubble to recordings.</string>
	<key>NSInputMonitoringUsageDescription</key>
	<string>PureShot needs input monitoring permission to show key press captions while recording.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>PureShot captures your microphone so recordings can include narration.</string>
	<key>NSQuitAlwaysKeepsWindows</key>
	<false/>
	<key>NSScreenCaptureUsageDescription</key>
	<string>PureShot needs screen recording permission to capture screenshots.</string>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeDescription</key>
			<string>PureShot Screenshot Preset</string>
			<key>UTTypeIdentifier</key>
			<string>apps.pure.pureshot.preset</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>pureshotpreset</string>
				</array>
				<key>public.mime-type</key>
				<string>application/vnd.pureshot.preset+json</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
